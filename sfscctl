#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
COMPOSE_FILE=${SFSC_COMPOSE_FILE:-docker-compose.yml}
BACKUP_DIR=${SFSC_BACKUP_DIR:-$ROOT/backups}
HEALTH_URL=${SFSC_HEALTH_URL:-}
RUNTIME=${SFSC_RUNTIME:-auto}
APPLIANCE_UNIT=${SFSC_APPLIANCE_UNIT:-sfsc-appliance.service}
MINIO_UNIT=${SFSC_MINIO_UNIT:-sfsc-minio.service}

usage() {
  echo "Usage: ./sfscctl {health|upgrade|backup|restore <archive>}" >&2
  exit 64
}

require_tool() {
  command -v "$1" >/dev/null 2>&1 || { echo "Missing required command: $1" >&2; exit 69; }
}

compose() {
  docker compose -f "$COMPOSE_FILE" "$@"
}

runtime() {
  if [ "$RUNTIME" != auto ]; then
    echo "$RUNTIME"
    return
  fi
  if command -v systemctl >/dev/null 2>&1 && systemctl cat "$APPLIANCE_UNIT" >/dev/null 2>&1; then
    echo appliance
  else
    echo compose
  fi
}

stop_runtime() {
  if [ "$(runtime)" = appliance ]; then
    systemctl stop "$APPLIANCE_UNIT" "$MINIO_UNIT"
  else
    compose down
  fi
}

start_runtime() {
  if [ "$(runtime)" = appliance ]; then
    systemctl start "$MINIO_UNIT" "$APPLIANCE_UNIT"
  else
    compose up -d --build
  fi
}

timestamp() {
  date -u +%Y%m%dT%H%M%SZ
}

backup() {
  require_tool tar
  require_tool sha256sum
  mkdir -p "$BACKUP_DIR"
  archive="$BACKUP_DIR/sfsc-backup-$(timestamp).tgz"
  umask 077
  tar -C "$ROOT" -czf "$archive" .env data sing-box
  sha256sum "$archive" > "$archive.sha256"
  echo "$archive"
}

verify_archive() {
  archive=$1
  [ -f "$archive" ] || { echo "Backup archive does not exist: $archive" >&2; exit 66; }
  if tar -tzf "$archive" | grep -Eq '(^/|(^|/)\.\.(/|$))'; then
    echo "Refusing unsafe backup archive path" >&2
    exit 65
  fi
  if tar -tzf "$archive" | grep -Ev '^(.env|data/?|data/.*|sing-box/?|sing-box/.*)$' | grep -q .; then
    echo "Refusing unexpected backup archive entry" >&2
    exit 65
  fi
}

restore() {
  archive=$1
  require_tool tar
  verify_archive "$archive"
  before=$(backup)
  stage=$(mktemp -d "$ROOT/.restore.XXXXXX")
  trap 'rm -rf "$stage"' EXIT INT TERM
  tar -xzf "$archive" -C "$stage"
  stop_runtime
  rm -rf "$ROOT/data" "$ROOT/sing-box"
  [ ! -e "$stage/.env" ] || cp -p "$stage/.env" "$ROOT/.env"
  [ ! -d "$stage/data" ] || cp -a "$stage/data" "$ROOT/data"
  [ ! -d "$stage/sing-box" ] || cp -a "$stage/sing-box" "$ROOT/sing-box"
  start_runtime
  echo "restore-prebackup=$before"
}

health() {
  require_tool docker
  if [ "$(runtime)" = appliance ]; then
    require_tool systemctl
    systemctl is-enabled "$MINIO_UNIT" "$APPLIANCE_UNIT"
    systemctl is-active "$MINIO_UNIT" "$APPLIANCE_UNIT"
    docker ps --filter name=sfsc-appliance --filter name=singbox-folder-sync-minio
    require_tool curl
    curl --fail --silent --show-error "${HEALTH_URL:-http://127.0.0.1:5177}/healthz"
    echo
    return
  fi
  compose ps
  if [ -n "$HEALTH_URL" ]; then
    require_tool curl
    curl --fail --silent --show-error "$HEALTH_URL/api/health"
    echo
  fi
}

upgrade() {
  require_tool docker
  before=$(backup)
  if [ "$(runtime)" = appliance ]; then
    sh "$ROOT/install-n1-appliance.sh"
  else
    compose up -d --build
  fi
  echo "upgrade-prebackup=$before"
}

case ${1:-} in
  health) health ;;
  backup) backup ;;
  upgrade) upgrade ;;
  restore) [ $# -eq 2 ] || usage; restore "$2" ;;
  *) usage ;;
esac
