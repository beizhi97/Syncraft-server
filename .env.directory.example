# Copy to server/.env.directory and replace the placeholder before installation.
SFSC_ADMIN_TOKEN=change-this-admin-token
SFSC_REQUIRE_ADMIN_TOKEN=1
PUBLIC_SERVER_URL=https://sync.example.com
SFSC_PUBLIC_HOST=sync.example.com
VLESS_PUBLIC_HOST=sync.example.com
VLESS_PUBLIC_PORT=45678
VLESS_PORT=45679
# S3/MinIO values are intentionally absent in directory mode.
