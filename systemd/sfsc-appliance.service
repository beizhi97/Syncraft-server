[Unit]
Description=Syncraft server appliance
Requires=docker.service sfsc-minio.service
After=docker.service network-online.target sfsc-minio.service
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=45
KillMode=mixed
KillSignal=SIGTERM
ExecStart=/usr/bin/python3 /opt/sfsc-test/server/runtime/sfsc-runtime-launcher --ledger-root /var/lib/sfsc-runtime --state-path /opt/sfsc-test/server/data/app/relation-services.json --image sfsc-appliance:local --deployment-id sfsc-appliance --env-file /opt/sfsc-test/server/.env --env HOST=0.0.0.0 --env PORT=5177 --env SERVER_DATA_ROOT=/data/app --env SINGBOX_CONFIG_PATH=/data/sing-box/config.json --env SINGBOX_CONTROL_DIR=/data/control --env SINGBOX_LISTEN_PORT=45679 --env VLESS_PORT=45679 --env RCLONE_BIN=/usr/local/bin/rclone --env S3_ENDPOINT=http://127.0.0.1:9000 --volume type=bind,src=/opt/sfsc-test/server/data/app,dst=/data/app --volume type=bind,src=/opt/sfsc-test/server/data/control,dst=/data/control --volume type=bind,src=/opt/sfsc-test/server/sing-box,dst=/data/sing-box

[Install]
WantedBy=multi-user.target
