[Unit]
Description=Syncraft MinIO storage
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=45
ExecStartPre=-/usr/bin/docker rm -f singbox-folder-sync-minio
ExecStart=/usr/bin/docker run --name singbox-folder-sync-minio --network host --env-file /opt/sfsc-test/server/.env -v /ssd/sfsc-test/minio:/data quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z server /data --address 127.0.0.1:9000 --console-address 127.0.0.1:9001
ExecStop=/usr/bin/docker stop --time 30 singbox-folder-sync-minio
ExecStopPost=-/usr/bin/docker rm -f singbox-folder-sync-minio

[Install]
WantedBy=multi-user.target

