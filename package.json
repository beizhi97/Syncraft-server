{
  "name": "singbox-folder-sync",
  "version": "0.3.0-rc.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "description": "Self-hosted sing-box and rclone folder sync client/server with a stable interface contract.",
  "scripts": {
    "start": "node src/server.js",
    "client:start": "node client/src/clientServer.js",
    "client:download-binaries": "powershell -ExecutionPolicy Bypass -File client/scripts/download-binaries.ps1",
    "client:package": "powershell -ExecutionPolicy Bypass -File client/scripts/build-client.ps1",
    "client:desktop": "electron client/electron/main.cjs",
    "client:desktop-package": "powershell -ExecutionPolicy Bypass -File client/scripts/build-desktop.ps1",
    "audit:compose": "node scripts/audit-compose.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "ci:verify": "powershell -ExecutionPolicy Bypass -File scripts/ci-verify.ps1",
    "preflight:release": "powershell -ExecutionPolicy Bypass -File scripts/preflight-release.ps1",
    "preflight:release:quick": "powershell -ExecutionPolicy Bypass -File scripts/preflight-release.ps1 -SkipTests -AllowSkips",
    "bundle:release": "powershell -ExecutionPolicy Bypass -File scripts/build-release-bundle.ps1",
    "release:status": "node scripts/release-status.mjs",
    "deploy:n1": "powershell -ExecutionPolicy Bypass -File scripts/deploy-n1.ps1",
    "apply:n1": "powershell -ExecutionPolicy Bypass -File scripts/apply-n1-singbox.ps1",
    "apply:beta-singbox": "powershell -ExecutionPolicy Bypass -File scripts/apply-beta-singbox.ps1",
    "postdeploy:n1": "powershell -ExecutionPolicy Bypass -File scripts/post-deploy-n1.ps1",
    "smoke:client": "node scripts/smoke-client.mjs",
    "smoke:electron-window": "node scripts/smoke-electron-window.mjs",
    "smoke:electron-e2e": "node scripts/smoke-electron-e2e.mjs",
    "smoke:client-package": "node scripts/smoke-client-package.mjs",
    "smoke:server": "node scripts/smoke-server.mjs",
    "trial:record": "node scripts/record-internal-trial.mjs",
    "trial:record:verify": "node scripts/record-internal-trial.mjs --verify",
    "trial:record:update": "node scripts/record-internal-trial.mjs --update --allow-pending",
    "trial:prepare": "node scripts/prepare-internal-trial.mjs",
    "trial:create-t-key": "node scripts/create-trial-t-key.mjs",
    "trial:assist": "node scripts/internal-trial-assistant.mjs",
    "trial:client-runner": "node scripts/client-trial-runner.mjs",
    "pilot:prepare": "node scripts/prepare-pilot-wave.mjs",
    "pilot:summary": "node scripts/pilot-summary.mjs",
    "test": "node --test \"tests/*.test.js\""
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "postject": "^1.0.0-alpha.6"
  }
}
